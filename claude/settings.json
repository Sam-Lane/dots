      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag)",
      "Bash(git tag -l*)",
      "Bash(git tag --list*)",
      "Bash(git blame:*)",
